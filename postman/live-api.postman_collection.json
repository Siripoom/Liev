{
  "info": {
    "name": "Live Streaming API",
    "description": "Collection สำหรับทดสอบ API ระบบ Live Streaming + One-Time Access Code",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com"
    },
    {
      "key": "adminPassword",
      "value": "admin1234"
    },
    {
      "key": "eventId",
      "value": ""
    },
    {
      "key": "accessCode",
      "value": ""
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "csvUrl",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "POST /api/admin/auth/login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/admin/me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "me"
              ]
            }
          }
        },
        {
          "name": "GET /api/admin/events",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "events"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "let data = [];",
                  "try { data = pm.response.json(); } catch (e) {}",
                  "if (Array.isArray(data) && data.length > 0 && data[0].id) {",
                  "  pm.collectionVariables.set('eventId', data[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/admin/events",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Event {{$timestamp}}\",\n  \"status\": \"live\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "events"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const data = pm.response.json();",
                  "if (data.id) pm.collectionVariables.set('eventId', data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /api/admin/events/:id -> live",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"live\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/events/{{eventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "events",
                "{{eventId}}"
              ]
            }
          }
        },
        {
          "name": "POST /api/admin/codes/bulk",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"quantity\": 2,\n  \"oneTime\": true,\n  \"maxUses\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/codes/bulk",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "codes",
                "bulk"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const data = pm.response.json();",
                  "if (data.codes && data.codes.length) pm.collectionVariables.set('accessCode', data.codes[0]);",
                  "if (data.csvUrl) pm.collectionVariables.set('csvUrl', data.csvUrl);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/admin/codes/export.csv",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/codes/export.csv?eventId={{eventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "codes",
                "export.csv"
              ],
              "query": [
                {
                  "key": "eventId",
                  "value": "{{eventId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/admin/auth/logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "auth",
                "logout"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Viewer",
      "item": [
        {
          "name": "POST /api/redeem",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{accessCode}}\",\n  \"eventId\": \"{{eventId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/redeem",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "redeem"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "if (data.sessionId) pm.collectionVariables.set('sessionId', data.sessionId);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/stream-url",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stream-url?eventId={{eventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "stream-url"
              ],
              "query": [
                {
                  "key": "eventId",
                  "value": "{{eventId}}"
                }
              ]
            }
          }
        },
        {
          "name": "POST /api/heartbeat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/heartbeat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "heartbeat"
              ]
            }
          }
        },
        {
          "name": "POST /api/redeem (invalid format)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"bad\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/redeem",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "redeem"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
