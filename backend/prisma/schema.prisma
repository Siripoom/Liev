generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  draft
  live
  ended
}

enum AdminRole {
  admin
}

model Event {
  id             String          @id @default(cuid())
  title          String
  status         EventStatus     @default(draft)
  hlsPath        String?         @map("hls_path")
  streamKey      String          @map("stream_key")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  accessCodes    AccessCode[]
  redemptions    Redemption[]
  viewerSessions ViewerSession[]

  @@map("events")
}

model AccessCode {
  id             String          @id @default(cuid())
  code           String          @unique
  eventId        String          @map("event_id")
  expiresAt      DateTime?       @map("expires_at")
  maxUses        Int             @default(1) @map("max_uses")
  usedCount      Int             @default(0) @map("used_count")
  isOneTime      Boolean         @default(true) @map("is_one_time")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  redemptions    Redemption[]
  viewerSessions ViewerSession[]

  @@index([eventId, code], map: "access_codes_event_id_code_idx")
  @@map("access_codes")
}

model Redemption {
  id         String    @id @default(cuid())
  codeId     String    @map("code_id")
  eventId    String    @map("event_id")
  sessionId  String    @map("session_id")
  redeemedAt DateTime  @default(now()) @map("redeemed_at")
  ip         String?
  userAgent  String?   @map("user_agent")
  code       AccessCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, redeemedAt], map: "redemptions_event_id_redeemed_at_idx")
  @@map("redemptions")
}

model ViewerSession {
  sessionId        String    @id @map("session_id")
  eventId          String    @map("event_id")
  codeId           String    @map("code_id")
  lastSeen         DateTime  @map("last_seen")
  isActive         Boolean   @default(true) @map("is_active")
  terminatedReason String?   @map("terminated_reason")
  createdAt        DateTime  @default(now()) @map("created_at")
  event            Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  code             AccessCode @relation(fields: [codeId], references: [id], onDelete: Cascade)

  @@index([codeId, isActive, lastSeen], map: "viewer_sessions_code_id_is_active_last_seen_idx")
  @@map("viewer_sessions")
}

model Admin {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         AdminRole  @default(admin)
  createdAt    DateTime   @default(now()) @map("created_at")
  lastLoginAt  DateTime?  @map("last_login_at")
  auditLogs    AuditLog[]

  @@map("admins")
}

model AuditLog {
  id           String    @id @default(cuid())
  actorAdminId String?   @map("actor_admin_id")
  action       String
  targetType   String    @map("target_type")
  targetId     String?   @map("target_id")
  metadata     Json?
  createdAt    DateTime  @default(now()) @map("created_at")
  actorAdmin   Admin?    @relation(fields: [actorAdminId], references: [id], onDelete: SetNull)

  @@index([actorAdminId, createdAt], map: "audit_logs_actor_admin_id_created_at_idx")
  @@map("audit_logs")
}
